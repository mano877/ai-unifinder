

# Groq API key (free at https://console.groq.com)
GROQ_API_KEY=

# PostgreSQL connection string (free at https://neon.tech)
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# Backend-only secret: generate with python -c "import secrets; print(secrets.token_urlsafe(32))"
# GET /leads requires Authorization: Bearer <this value>. Empty disables access.
# Never put this value in frontend environment variables.
LEADS_ADMIN_TOKEN=

# Comma-separated exact origins, without paths. Add your Vercel origin when known.
ALLOWED_ORIGINS=
